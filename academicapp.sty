\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academicapp}[2026/11/12 Shiqi Zhang academic application style]
\RequirePackage{fontspec,microtype,fancyhdr,titlesec,setspace,xcolor,hyperref,enumitem,tabularx,array}
\definecolor{accent}{HTML}{174B69}
\hypersetup{colorlinks=true,urlcolor=accent,pdfauthor={Shiqi Zhang}}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{2em}
\newcommand{\ApplicantName}[1]{{\fontsize{24}{27}\selectfont\bfseries\color{accent}#1}\par}
\newcommand{\ApplicantSubtitle}[1]{{\large #1}\par}
\newcommand{\ApplicantMeta}[1]{{\small #1}\par}
\newcommand{\ApplicationTitle}[1]{{\fontsize{20}{23}\selectfont\bfseries\color{accent}#1}\par}
\newcommand{\DocumentSubtitle}[1]{{\small #1}\par}
\titleformat{\section}{\large\bfseries\color{accent}}{}{0pt}{}[\vspace{1pt}\titlerule]
\titlespacing*{\section}{0pt}{6pt}{3pt}
\titleformat{\subsection}{\normalsize\bfseries\color{accent}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{4pt}{2pt}
\setlist[itemize]{leftmargin=14pt,itemsep=1.5pt,topsep=2pt,parsep=0pt}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\newcommand{\SetAppFooter}[1]{\fancyfoot[L]{\footnotesize\color{gray}Shiqi Zhang | #1}\fancyfoot[R]{\footnotesize\thepage}}
